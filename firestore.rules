rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    // Invite codes: anyone signed in can look up ONE code they know (no listing).
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId'])
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.memberUids;
      allow update, delete: if false;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;
      // Members can change the trip.
      allow update: if signedIn() && request.auth.uid in resource.data.memberUids
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.code == resource.data.code;
      // Someone holding the invite code (and therefore the trip id) may add only themselves.
      allow update: if signedIn() && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.auth.uid in request.resource.data.memberUids;
      allow delete: if signedIn() && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
